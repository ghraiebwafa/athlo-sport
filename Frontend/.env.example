# Expo public env vars (bundled into the app at build time)

# iOS Simulator / web
EXPO_PUBLIC_AUTH_API_URL=http://localhost:5001
EXPO_PUBLIC_MANAGEMENT_API_URL=http://localhost:5000

# Android Emulator — uncomment and use instead of localhost:
# EXPO_PUBLIC_AUTH_API_URL=http://10.0.2.2:5001
# EXPO_PUBLIC_MANAGEMENT_API_URL=http://10.0.2.2:5000

# Physical device — use your machine's LAN IP:
# EXPO_PUBLIC_AUTH_API_URL=http://192.168.1.100:5001
# EXPO_PUBLIC_MANAGEMENT_API_URL=http://192.168.1.100:5000

# Optional crash reporting (wire @sentry/react-native in a native/EAS build)
# EXPO_PUBLIC_SENTRY_DSN=
