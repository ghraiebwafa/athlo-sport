# Postgres (docker-compose + local dotnet run)
POSTGRES_DB=athlo
POSTGRES_USER=athlo
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Or full connection string (Docker overrides this internally)
# ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=athlo;Username=athlo;Password=change_me

# Redis — optional; enables distributed rate limiting + login lockout
# Docker Compose defaults to redis:6379. Local host APIs: localhost:16379 via docker-compose.local.yml
# Leave unset to use in-process memory cache.
# ConnectionStrings__Redis=localhost:16379

# JWT (required — min 32 chars; setup-env.sh auto-generates)
Jwt__Secret=change_me
Jwt__Issuer=Athlo
Jwt__Audience=AthloMobile
Jwt__AccessTokenExpirationMinutes=60
Jwt__RefreshTokenExpirationDays=7

# Super admin (required — password min 12 chars; setup-env.sh auto-generates)
SuperAdmin__Email=superadmin@athlo.internal
SuperAdmin__Password=change_me
SuperAdmin__FullName=Super Admin

# CORS (optional)
Cors__AllowedOrigins=http://localhost:8081,http://localhost:19006

# SMTP — required in production for password reset emails
# Smtp__Host=
# Smtp__Port=587
# Smtp__User=
# Smtp__Password=
# Smtp__From=noreply@athlo.local
# Smtp__EnableSsl=true

# Host filtering — restrict in production to prevent host header attacks
# AllowedHosts=yourdomain.com;api.yourdomain.com

# Dev only — return reset token in forgot-password API response (never enable in production)
# Auth__ExposeResetTokenInResponse=false
